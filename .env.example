# ─── Foundry Protocol — single source of truth for env vars ──────────────
#
# Copy to `.env` at the repo root and fill in. This file documents EVERY
# secret used across the deploy, the web app, the eval coordinator, the
# indexer, and the smoke tests. Where each var actually needs to live is
# called out in [Used by: …].
#
# .env is git-ignored. Never commit. Rotate any secret pasted into chat.

# ─── 0G Chain ────────────────────────────────────────────────────────────
RPC_ARISTOTLE=https://evmrpc.0g.ai                # [Used by: deploy script, eval-coordinator, web (zg-compute, storage), smoke test]
RPC_GALILEO=https://evmrpc-testnet.0g.ai          # [Used by: optional testnet runs]
FOUNDRY_NETWORK=aristotle                         # aristotle | galileo | local

# ─── Deployer / treasury / coordinator ──────────────────────────────────
# The single key used both as deployer AND coordinator (per your call).
# Must be funded with OG on Aristotle. ~0.02 OG covers the full deploy.
DEPLOYER_KEY_ARISTOTLE=0x...                      # [Used by: forge script Deploy.s.sol]
COORDINATOR_KEY=0x...                             # SAME value as DEPLOYER_KEY_ARISTOTLE
                                                  # [Used by: eval-coordinator]
TREASURY_ADDR=0x...                               # receives FORGE supply + 2.5% protocol fee
                                                  # [Used by: forge script Deploy.s.sol]

# ─── 0G Compute (inference) ─────────────────────────────────────────────
# Required for the OpenAI-compatible proxy to actually route to a real
# provider. Without these the proxy returns labeled stub responses.
ZG_BROKER_KEY=0x...                               # broker wallet — needs prepaid balance with provider
ZG_BROKER_RPC=https://evmrpc.0g.ai                # defaults to mainnet; override for testnet
ZG_INFERENCE_PROVIDER=0x...                       # on-chain provider address
ZG_INFERENCE_MODEL=                               # optional: override model name returned by getServiceMetadata
ZG_REVENUE_FEE_WEI=100000000000000                # 0.0001 OG per call → RevenueSplitter
                                                  # [Used by: web (apps/web/lib/zg-compute.ts), eval-coordinator]

# ─── 0G Storage ─────────────────────────────────────────────────────────
ZG_STORAGE_KEY=0x...                              # signer for upload txs (can be DEPLOYER_KEY_ARISTOTLE)
ZG_STORAGE_INDEXER=https://indexer-storage.0g.network   # [Used by: web (/api/storage/upload), eval-coordinator, SDK]
STORAGE_UPLOAD_TOKEN=                             # shared-secret bearer for /api/storage/upload
                                                  # generate with: openssl rand -hex 24

# ─── 0G DA (optional) ───────────────────────────────────────────────────
ZG_DA_ENCODER_URL=                                # leave blank to degrade to local-digest mode
ZG_DA_API_KEY=                                    # [Used by: eval-coordinator, SDK DAClient]

# ─── Eval coordinator runtime ───────────────────────────────────────────
POLL_INTERVAL_SECS=12                             # [Used by: eval-coordinator]
TEE_ENABLED=true                                  # honest label of whether a real DCAP quote is produced
START_BLOCK=0                                     # rescan from this block
COORDINATOR_STATE_PATH=/data/state.json           # mount a persistent volume here on Railway

# ─── Web app ────────────────────────────────────────────────────────────
NEXT_PUBLIC_FOUNDRY_NETWORK=aristotle             # [Used by: apps/web; client-visible]

# ─── npm publish (NOT for runtime) ──────────────────────────────────────
# Don't put NPM_TOKEN in this file in production. Use:
#   npm config set //registry.npmjs.org/:_authToken=$NPM_TOKEN  (CI)
# or  ~/.npmrc                                                    (local)
