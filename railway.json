{
  "$schema": "https://railway.com/railway.schema.json",
  "build": {
    "builder": "DOCKERFILE",
    "dockerfilePath": "apps/eval-coordinator/Dockerfile"
  },
  "deploy": {
    "startCommand": "node apps/eval-coordinator/dist/index.js",
    "restartPolicyType": "ALWAYS",
    "restartPolicyMaxRetries": 10
  }
}
