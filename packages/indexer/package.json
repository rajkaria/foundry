{
  "name": "@foundryprotocol/indexer",
  "version": "0.0.0",
  "private": true,
  "description": "Foundry indexer — watches 0G Aristotle events; serves typed reads via tRPC.",
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsup",
    "start": "node dist/index.js",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --passWithNoTests",
    "lint": "echo 'lint pending'",
    "clean": "rimraf dist"
  },
  "dependencies": {
    "@trpc/server": "^11.0.0",
    "viem": "^2.21.0"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "rimraf": "^6.0.1",
    "tsup": "^8.3.5",
    "tsx": "^4.19.2",
    "typescript": "^5.6.3",
    "vitest": "^2.1.8"
  }
}
