{
  "name": "@foundryprotocol/sdk",
  "version": "1.1.0",
  "description": "Foundry SDK — pool data, compute, and capital to co-train AI models on 0G. Mint a verifiable, revenue-generating share. Three-line inference, full lifecycle.",
  "license": "MIT",
  "homepage": "https://foundryprotocol.xyz",
  "repository": {
    "type": "git",
    "url": "https://github.com/rajkaria/foundry.git",
    "directory": "packages/sdk"
  },
  "bugs": {
    "url": "https://github.com/rajkaria/foundry/issues"
  },
  "author": "Foundry Protocol",
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./storage": {
      "types": "./dist/storage.d.ts",
      "import": "./dist/storage.js"
    },
    "./da": {
      "types": "./dist/da.d.ts",
      "import": "./dist/da.js"
    },
    "./attestation": {
      "types": "./dist/attestation.d.ts",
      "import": "./dist/attestation.js"
    },
    "./inference": {
      "types": "./dist/inference.d.ts",
      "import": "./dist/inference.js"
    },
    "./abis": {
      "types": "./dist/abis.d.ts",
      "import": "./dist/abis.js"
    },
    "./adapters/vercel-ai": {
      "types": "./dist/adapters/vercel-ai.d.ts",
      "import": "./dist/adapters/vercel-ai.js"
    },
    "./adapters/langchain": {
      "types": "./dist/adapters/langchain.d.ts",
      "import": "./dist/adapters/langchain.js"
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "lint": "echo 'lint pending'",
    "clean": "rimraf dist",
    "prepublishOnly": "pnpm run clean && pnpm run build"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "rimraf": "^6.0.1",
    "tsup": "^8.3.5",
    "typescript": "^5.6.3",
    "vitest": "^2.1.8"
  },
  "peerDependencies": {
    "viem": "^2.21.0",
    "@langchain/core": ">=0.3.0",
    "ai": ">=3.0.0"
  },
  "peerDependenciesMeta": {
    "@langchain/core": {
      "optional": true
    },
    "ai": {
      "optional": true
    }
  },
  "dependencies": {
    "@foundryprotocol/0gkit-attestation": "^1.5.0",
    "@foundryprotocol/0gkit-core": "^1.5.0",
    "@foundryprotocol/0gkit-da": "^1.5.0",
    "@foundryprotocol/0gkit-storage": "^1.12.0",
    "viem": "^2.21.0"
  },
  "keywords": [
    "0g",
    "0g-network",
    "0g-storage",
    "0g-compute",
    "0g-da",
    "foundry",
    "ai",
    "llm",
    "attribution",
    "model-ownership",
    "ingot",
    "tee",
    "langchain",
    "vercel-ai-sdk"
  ],
  "publishConfig": {
    "access": "public"
  }
}
