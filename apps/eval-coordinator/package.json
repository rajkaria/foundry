{
  "name": "@foundryprotocol/eval-coordinator",
  "version": "0.1.0",
  "private": true,
  "description": "Eval coordinator daemon — watches Forges, runs attribution inside a TEE on 0G Compute, signs the envelope, posts to 0G DA, submits on-chain.",
  "type": "module",
  "main": "./dist/index.js",
  "bin": {
    "foundry-eval-coordinator": "./dist/index.js"
  },
  "scripts": {
    "build": "tsup",
    "dev": "tsx watch src/index.ts",
    "start": "node dist/index.js",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --passWithNoTests",
    "clean": "rimraf dist"
  },
  "dependencies": {
    "@0gfoundation/0g-compute-ts-sdk": "^0.8.3",
    "@0gfoundation/0g-storage-ts-sdk": "^1.2.9",
    "@foundryprotocol/sdk": "workspace:*",
    "viem": "^2.21.0",
    "ethers": "^6.16.0",
    "pino": "^9.5.0",
    "pino-pretty": "^11.3.0"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "rimraf": "^6.0.1",
    "tsup": "^8.3.5",
    "tsx": "^4.19.2",
    "typescript": "^5.6.3",
    "vitest": "^2.1.8"
  }
}
